<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>command</key>
	<string>#!/usr/bin/env ruby -wEutf-8
# Thin wrapper: real work lives in Support/lib/markdown_table.rb.
$:.unshift ENV['TM_BUNDLE_SUPPORT']
require 'lib/markdown_table'
STDIN.set_encoding(Encoding::UTF_8)
STDOUT.set_encoding(Encoding::UTF_8)
print MarkdownTable.tabbed_to_table(STDIN.read)</string>
	<key>input</key>
	<string>selection</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>name</key>
	<string>Tabbed text -&gt; Table</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>text</string>
	<key>outputLocation</key>
	<string>replaceInput</string>
	<key>scope</key>
	<string>text.html.markdown</string>
	<key>uuid</key>
	<string>D3E428FD-89F8-4A50-A1DF-249582631FC7</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
