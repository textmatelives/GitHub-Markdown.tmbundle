<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>command</key>
	<string>#!/usr/bin/env ruby -wEutf-8
# Thin wrapper: real work lives in Support/lib/task_list.rb.
$:.unshift ENV['TM_BUNDLE_SUPPORT']
require 'lib/task_list'
STDIN.set_encoding(Encoding::UTF_8)
STDOUT.set_encoding(Encoding::UTF_8)
if ENV['TM_SELECTED_TEXT'].to_s.empty?
	text = $stdin.read
	caretline = ENV['TM_LINE_NUMBER'].to_i - ENV['TM_INPUT_START_LINE'].to_i
	# TM_LINE_INDEX is UTF-8 bytes; Ruby 2+ indexes by character.
	index = TaskList.byte_col_to_char_col(ENV['TM_CURRENT_LINE'], ENV['TM_LINE_INDEX'].to_i)
	print TaskList.insert_task(text, caretline, index) { |l| TaskList.escape_snippet(l) }
else
	# Selection: replace it with a fresh box at the caret line's indent.
	print TaskList.escape_snippet(ENV['TM_CURRENT_LINE'].to_s[/\A\s*/].to_s + "- [ ] ") + "$0"
end</string>
	<key>fallbackInput</key>
	<string>scope</string>
	<key>input</key>
	<string>selection</string>
	<key>inputFormat</key>
	<string>text</string>
	<key>name</key>
	<string>Insert Task</string>
	<key>outputCaret</key>
	<string>afterOutput</string>
	<key>outputFormat</key>
	<string>snippet</string>
	<key>outputLocation</key>
	<string>replaceInput</string>
	<key>scope</key>
	<string>text.html.markdown</string>
	<key>tabTrigger</key>
	<string>task</string>
	<key>uuid</key>
	<string>BE62910C-A171-493B-9CA1-B7E8DDA8C20E</string>
	<key>version</key>
	<integer>2</integer>
</dict>
</plist>
