# Dependencies for the GitHub Flavored Markdown preview command.
# Installed once into TextMate's shared gem store via TextMate::Gems.setup.
#
#   redcarpet — GFM renderer (replaces the old Markdown.pl path)
#   rouge     — pure-Ruby syntax highlighter (replaces the Python pygments dep)
#
# Versions are pinned to the last releases that support system Ruby 2.6.x.
source "https://rubygems.org"

gem "redcarpet", "3.6.1"
gem "rouge", "3.30.0"

# Rouge 3.x calls CGI.parse in Lexer.lookup_fancy, and Ruby 4.0 no longer
# ships it: its lib/cgi.rb keeps escape/unescape only and points you at the
# cgi gem or Bundler. Without this, any code block with no language tag —
# including every indented one — raises NoMethodError under a modern TM_RUBY.
# Rouge fixed this in 4.6.1, which needs Ruby >= 2.7; drop the pin and bump
# rouge once the 2.6 floor goes.
gem "cgi", "0.5.2"
